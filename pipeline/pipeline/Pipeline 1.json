					}
				},
				"inputs": [
					{
						"referenceName": "Parquet1",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "BronzeSinkDataSet",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": [],
		"lastPublishTime": "2026-09-10T16:13:50Z"
	},
	"type": "Microsoft.Synapse/workspaces/pipelines"
